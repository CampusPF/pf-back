# ============================================================
# Campus Lite API — variables de entorno
#
# Copiar a `.env` y completar. NUNCA commitear el `.env` real.
# El arranque valida este esquema (src/config/env.validation.ts) y falla
# rápido si falta algo requerido.
# ============================================================

# --- Entorno ---
# development | test | production
# En 'production' se endurecen varias reglas: Swagger apagado, sin stack
# traces en las respuestas, synchronize de TypeORM en false, CORS sin
# localhost y JWT_SECRET de 32+ caracteres.
NODE_ENV=development
PORT=4000

# --- Base de datos (todas requeridas) ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=tu_password
DB_NAME=campus_lite
# true si la base exige TLS (Railway, Render, Neon, Supabase). En local, false.
DB_SSL=false

# --- Autenticación / JWT ---
# REQUERIDA. En producción tiene que tener 32+ caracteres.
# Generar con: openssl rand -hex 32
JWT_SECRET=reemplazar_por_un_secret_largo_y_aleatorio
# Validez del access token, en SEGUNDOS (3600 = 1 hora, 86400 = 1 día).
JWT_EXPIRES_IN=3600

# --- Frontend / CORS ---
# Origen(es) permitidos del front, separados por coma (sin barra final).
# En producción es requerida y NO puede ser '*' ni contener localhost.
# Ej. prod + preview: https://campus.vercel.app,https://preview.campus.vercel.app
FRONTEND_URL=http://localhost:3000

# --- Reverse proxy ---
# Cantidad de hops de proxy delante de la app. Necesario para que Express
# resuelva la IP REAL del cliente (req.ip) y no la de un proxy intermedio —
# de eso depende que el rate limiting cuente por IP correctamente.
#
# No asumas "1 hop = 1 proxy visible en la arquitectura": cada capa cuenta
# (Cloudflare + el balanceador interno del hosting ya son 2, aunque para vos
# sea "un solo servicio"). Si el número queda corto, req.ip termina resolviendo
# a la IP de un proxy (que cambia en cada request si es un CDN como Cloudflare,
# con miles de edges) y el rate limit deja de funcionar sin ningún error visible.
#
# Valores verificados en este proyecto:
#   - Local / sin proxy: 0 (o no seteues la variable)
#   - Render (usa Cloudflare + su propio proxy interno): 3
#   - Railway / Nginx propio sin CDN: probá con 1 primero
#
# Cómo verificarlo vos mismo si cambiás de hosting: agregá temporalmente un
# endpoint público que devuelva `req.ip` y el header `x-forwarded-for`
# completo, pegale con curl, y probá números hasta que `req.ip` coincida con
# el primer valor (el más a la izquierda) de x-forwarded-for de forma ESTABLE
# en varios requests seguidos (no alcanza con que coincida una vez).
TRUST_PROXY=1

# --- Rate limiting ---
# Ventana en segundos y límites por ventana.
THROTTLE_TTL=60
THROTTLE_LIMIT=100        # límite general (por usuario logueado, o por IP)
THROTTLE_AUTH_LIMIT=10    # login y register (por IP) — anti fuerza bruta
THROTTLE_AI_LIMIT=20      # mensajes al tutor IA (por usuario) — costo/abuso

# --- Google OAuth (requeridas en producción) ---
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# --- Pagos: Stripe (requeridas en producción) ---
# Secret key del backend. NUNCA la publishable (esa va en el front, en
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY). Empieza con sk_test_ / sk_live_.
STRIPE_SECRET_KEY=sk_test_...
# Secret para verificar la firma del webhook. En local lo imprime:
#   stripe listen --forward-to localhost:4000/payments/webhook
# En producción lo da el dashboard de Stripe (Developers > Webhooks).
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Swagger ---
# En producción está apagado por defecto (expone el contrato completo).
# Ponerlo en true solo si hace falta y detrás de algún control de acceso.
SWAGGER_ENABLED=false

# --- Proveedor de IA (tutor) ---
# Hoy el tutor usa MockAiProvider y NO llama a ninguna API externa, así que
# estas variables todavía no son necesarias.
# TODO(seguridad): al elegir proveedor, cargar la key que corresponda y
# marcarla como requerida en producción en src/config/env.validation.ts.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- Pagos: Mercado Pago (OBSOLETO) ---
# El proyecto arrancó apuntando a Mercado Pago, pero el equipo se fue con
# Stripe (ver STRIPE_* arriba). Estas variables ya no se usan ni se validan.
# MP_ACCESS_TOKEN=
# MP_WEBHOOK_SECRET=

# --- Archivos: Cloudinary ---
# TODO(seguridad): la API NO tiene endpoints de upload todavía. Al agregarlos:
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=   # solo backend, nunca se expone al front
