# ============================================================
# Campus Lite API — variables de entorno
#
# Copiar a `.env` y completar. NUNCA commitear el `.env` real.
# El arranque valida este esquema (src/config/env.validation.ts) y falla
# rápido si falta algo requerido.
# ============================================================

# --- Entorno ---
# development | test | production
# En 'production' se endurecen varias reglas: Swagger apagado, sin stack
# traces en las respuestas, synchronize de TypeORM en false, CORS sin
# localhost y JWT_SECRET de 32+ caracteres.
NODE_ENV=development
PORT=4000

# --- Base de datos (todas requeridas) ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=tu_password
DB_NAME=campus_lite
# true si la base exige TLS (Railway, Render, Neon, Supabase). En local, false.
DB_SSL=false

# --- Autenticación / JWT ---
# REQUERIDA. En producción tiene que tener 32+ caracteres.
# Generar con: openssl rand -hex 32
JWT_SECRET=reemplazar_por_un_secret_largo_y_aleatorio
# Validez del access token, en SEGUNDOS (3600 = 1 hora, 86400 = 1 día).
JWT_EXPIRES_IN=3600
# REQUERIDA. Firma los tokens de "recuperar contraseña" (válidos 1 hora).
# TIENE que ser DISTINTA de JWT_SECRET: un token de reseteo filtrado no debe
# servir como sesión, ni al revés. En producción, 32+ caracteres.
# Generar con: openssl rand -hex 32
JWT_RESET_SECRET=reemplazar_por_otro_secret_distinto_al_de_arriba

# --- Web Push (generar con: npx web-push generate-vapid-keys) ---
VAPID_PUBLIC_KEY=replace_with_generated_public_key
VAPID_PRIVATE_KEY=replace_with_generated_private_key
VAPID_SUBJECT=mailto:ohverde@gmail.com

# --- Cron externo (opcional) ---
# Habilita POST /tasks/course-push-reminders, /tasks/weekly-reminders y
# /tasks/ping, que un cron externo dispara mandando este valor en el header
# `x-cron-secret`. Hace falta porque el cron interno no corre si el servicio
# está dormido (plan free de Render).
# Sin esta variable esos endpoints responden 404. Generalo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# --- Frontend / CORS ---
# Origen(es) permitidos del front, separados por coma (sin barra final).
# En producción es requerida y NO puede ser '*' ni contener localhost.
# Ej. prod + preview: https://campus.vercel.app,https://preview.campus.vercel.app
FRONTEND_URL=http://localhost:3000

# --- Reverse proxy ---
# Cantidad de hops de proxy delante de la app. Necesario para que Express
# resuelva la IP REAL del cliente (req.ip) y no la de un proxy intermedio —
# de eso depende que el rate limiting cuente por IP correctamente.
#
# No asumas "1 hop = 1 proxy visible en la arquitectura": cada capa cuenta
# (Cloudflare + el balanceador interno del hosting ya son 2, aunque para vos
# sea "un solo servicio"). Si el número queda corto, req.ip termina resolviendo
# a la IP de un proxy (que cambia en cada request si es un CDN como Cloudflare,
# con miles de edges) y el rate limit deja de funcionar sin ningún error visible.
#
# Valores verificados en este proyecto:
#   - Local / sin proxy: 0 (o no seteues la variable)
#   - Render (usa Cloudflare + su propio proxy interno): 3
#   - Railway / Nginx propio sin CDN: probá con 1 primero
#
# Cómo verificarlo vos mismo si cambiás de hosting: agregá temporalmente un
# endpoint público que devuelva `req.ip` y el header `x-forwarded-for`
# completo, pegale con curl, y probá números hasta que `req.ip` coincida con
# el primer valor (el más a la izquierda) de x-forwarded-for de forma ESTABLE
# en varios requests seguidos (no alcanza con que coincida una vez).
TRUST_PROXY=1

# --- Rate limiting ---
# Ventana en segundos y límites por ventana.
THROTTLE_TTL=60
THROTTLE_LIMIT=100        # límite general (por usuario logueado, o por IP)
THROTTLE_AUTH_LIMIT=10    # login y register (por IP) — anti fuerza bruta
THROTTLE_AI_LIMIT=20      # mensajes al tutor IA (por usuario) — costo/abuso
# Alto a propósito: el dictado transcribe mientras se habla, así que un solo
# dictado son ~8 llamadas (una cada 4 s más la final).
THROTTLE_SPEECH_LIMIT=60  # transcripciones por minuto (por usuario)

# --- Google OAuth (requeridas en producción) ---
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# --- Pagos: Stripe (requeridas en producción) ---
# Secret key del backend. NUNCA la publishable (esa va en el front, en
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY). Empieza con sk_test_ / sk_live_.
STRIPE_SECRET_KEY=sk_test_...
# Secret para verificar la firma del webhook. En local lo imprime:
#   stripe listen --forward-to localhost:4000/payments/webhook
# En producción lo da el dashboard de Stripe (Developers > Webhooks).
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Swagger ---
# Fuera de producción siempre está prendido. En producción depende de esta
# variable: en Render está en true para publicar la doc en
# https://<servicio>.onrender.com/api (UI) y /api-json (spec OpenAPI).
# Ponerla en false la apaga sin tocar código.
SWAGGER_ENABLED=true

# --- Proveedor de IA (tutor) ---
# AI_PROVIDER elige el principal; el otro es respaldo automático si falla.
# Keys gratis: https://aistudio.google.com/apikey y https://console.groq.com/keys
AI_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# GROQ_MODEL=openai/gpt-oss-120b
# Mensajes por día al tutor en plan gratis (Premium es ilimitado).
AI_FREE_DAILY_LIMIT=20

# --- Moderación de reseñas ---
# Reusa GROQ_API_KEY. Sin key, sólo filtra la lista local de groserías.
# MODERATION_MODEL=openai/gpt-oss-safeguard-20b

# --- Dictado por voz (speech-to-text) ---
# Whisper en Groq: reusa GROQ_API_KEY (sin key, el micrófono no aparece).
# El audio se transcribe y se descarta: no se guarda.
# SPEECH_MODEL=whisper-large-v3-turbo

# --- Pagos: Mercado Pago (OBSOLETO) ---
# El proyecto arrancó apuntando a Mercado Pago, pero el equipo se fue con
# Stripe (ver STRIPE_* arriba). Estas variables ya no se usan ni se validan.
# MP_ACCESS_TOKEN=
# MP_WEBHOOK_SECRET=

# --- Archivos: Cloudinary ---
# Portadas de curso, imágenes de categoría y avatares (públicos), y PDFs
# adjuntos de lección (privados, servidos con URL firmada que vence).
# Los videos NO pasan por acá: Lesson.videoUrl sigue siendo una URL externa.
# En dev son opcionales; sin ellas la app arranca y los endpoints de subida
# responden 503.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=   # solo backend, nunca se expone al front

# --- Mails transaccionales: Brevo (requeridas en producción) ---
# Se usa para todos los mails: recuperar contraseña, bienvenida, inscripción,
# compra, certificado y recordatorios.
# En dev son opcionales: fuera de producción los mails NO se envían, se
# escriben en el log (así no se gastan los 300 mails/día del plan gratuito).
#
# La key se genera en el dashboard de Brevo: SMTP y API > API Keys.
# Empieza con xkeysib-. Ojo: NO son las credenciales SMTP de esa misma
# pantalla, es la API key.
BREVO_API_KEY=xkeysib-...
# Tiene que coincidir EXACTAMENTE con un remitente verificado en Brevo
# (Remitentes, dominio, IP > Remitentes), o la API responde 403.
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Campus

# --- Notificaciones por mail: plantillas locales ---
# El HTML de los mails se genera en el back (src/mail/templates); no hace falta
# crear plantillas en Brevo. Sólo se usa la API key y el remitente verificado.
# Logo de los mails (URL pública). Vacío = FRONTEND_URL + /logo-campus.png
MAIL_LOGO_URL=
# true = manda a Brevo de verdad también en dev (para probar los mails
# contra una casilla propia). Gasta cupo del plan.
MAIL_FORCE_SEND=false

# --- Recordatorios semanales (cron) ---
# Expresión cron y zona horaria: por defecto, lunes 10:00 hora de Argentina.
REMINDER_CRON=0 10 * * 1
REMINDER_TZ=America/Argentina/Buenos_Aires
# Días sin abrir una lección del curso / sin crear un curso para recordar.
STUDENT_INACTIVITY_DAYS=7
TEACHER_INACTIVITY_DAYS=30
# URL pública de ESTE back (sin barra final): arma el link de baja.
API_PUBLIC_URL=http://localhost:4000
# Firma los links de baja de los recordatorios. Requerido en producción.
# Generá uno con: openssl rand -hex 32
JWT_UNSUBSCRIBE_SECRET=

COURSE_PUSH_CRON=0 19 */3 * *
COURSE_PUSH_TZ=America/Argentina/Buenos_Aires
COURSE_PUSH_MIN_INTERVAL_DAYS=3